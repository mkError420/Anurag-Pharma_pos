<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Backend API requests
  RewriteRule ^backend/(.*)$ backend/index.php [L,QSA]

  # 2. Assets routing to frontend/dist/assets
  RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]

  # 3. SPA Fallback - route all other requests to frontend/dist/index.html
  RewriteCond %{REQUEST_URI} !^/backend/
  RewriteCond %{REQUEST_URI} !^/frontend/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ frontend/dist/index.html [L,QSA]
</IfModule>

# Enable GZIP Compression for all text/script/css assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Enable Browser Caching for static assets (hashed files can be cached safely)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>